# Copy to server/.env  (PowerShell: Copy-Item server/.env.example server/.env)
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Set to true only when running behind a reverse proxy (affects req.ip in the audit log)
TRUST_PROXY=false

DATABASE_URL=postgres://ridemate:ridemate@localhost:5432/ridemate
TEST_DATABASE_URL=postgres://ridemate:ridemate@localhost:5432/ridemate_test

# Comma-separated list of email domains allowed to register
ALLOWED_EMAIL_DOMAINS=usiu.ac.ke

# --- Firebase ---
# Local dev: use the Auth Emulator (no real project needed). "demo-" project ids are emulator-only.
FIREBASE_PROJECT_ID=demo-ridemate
FIREBASE_USE_EMULATOR=true
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Real project: set FIREBASE_USE_EMULATOR=false and point this at a service-account JSON file
GOOGLE_APPLICATION_CREDENTIALS=

# --- Google Maps (Sprint II). Leave empty to use the mock geocoder/router in development ---
GOOGLE_MAPS_SERVER_KEY=

# --- Matching engine (Sprint II) ---
MATCHER_URL=http://localhost:8000
MATCHER_INTERNAL_KEY=change-me-to-a-long-random-string

# --- Admins ---
# Comma-separated real email addresses (not students) that become admins when they sign up.
# They may use any email domain. Example: ADMIN_EMAILS=you@gmail.com
ADMIN_EMAILS=

# --- Email (optional). Without SMTP_HOST, emails are printed to the API console instead ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RideMate <no-reply@ridemate.local>
# Used for links inside emails
APP_URL=http://localhost:5173

# --- Drivers and demo accounts ---
# true lets people with any email (Gmail, etc.) sign up and apply to drive; an admin must approve them.
ALLOW_DRIVER_SIGNUP=false
# Comma-separated demo domains. Accounts on these domains are accepted as students and verified automatically,
# with no inbox. For demos only: leave empty in production.
DEMO_EMAIL_DOMAINS=

# Drivers are separate accounts. Set to true only if rider accounts (students and staff) may also drive.
STUDENTS_CAN_DRIVE=false
