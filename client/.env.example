# Copy to client/.env  (PowerShell: Copy-Item client/.env.example client/.env)
# Vite dev server proxies /api to the Express server on :4000
VITE_API_BASE_URL=/api

# --- Firebase web config ---
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-ridemate.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-ridemate
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_USE_EMULATOR=true
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# --- Google Maps (Sprint II). Browser key restricted to your domains; leave empty for mock mode ---
VITE_GOOGLE_MAPS_BROWSER_KEY=
